#!/bin/sh
set -eu

on_cygwin=0
if command -v cygpath >/dev/null 2>&1; then
	on_cygwin=1
fi

if [ "$on_cygwin" = 1 ] && [ -n "${JAVA:-}" ]; then
	java=$(cygpath --unix "$JAVA")
else
	java=${JAVA:-}
fi

if [ "$on_cygwin" = 1 ] && [ -n "${JAVA_HOME:-}" ]; then
	java_home=$(cygpath --unix "$JAVA_HOME")
else
	java_home=${JAVA_HOME:-}
fi

# Honor JAVA if set; otherwise use JAVA_HOME/bin/java or java from PATH.
if [ -z "$java" ]; then
	if [ -n "$java_home" ]; then
		java="$java_home/bin/java"
	else
		java=$(command -v java || true)
	fi
fi

if [ -z "$java" ] || [ ! -x "$java" ]; then
	echo "ERROR: Could not find executable java (set JAVA or JAVA_HOME, or ensure java is on PATH)." >&2
	exit 1
fi

# Resolve symlinks to locate the real directory containing this wrapper script.
executable=$0
if command -v readlink >/dev/null 2>&1; then
	if resolved=$(readlink -f "$executable" 2>/dev/null); then
		executable=$resolved
	else
		while [ -L "$executable" ]; do
			link_dir=$(dirname "$executable")
			target=$(readlink "$executable")
			case "$target" in
				/*) executable=$target ;;
				*) executable="$link_dir/$target" ;;
			esac
		done
	fi
fi
basedir=$(CDPATH='' cd -- "$(dirname "$executable")" && pwd)

jar=""
for candidate in \
	"$basedir/build/libs/abe-all.jar" \
	"$basedir/abe-all.jar" \
	"$basedir/abe.jar"; do
	if [ -f "$candidate" ]; then
		jar=$candidate
		break
	fi
done

if [ -z "$jar" ]; then
	echo "ERROR: Could not find abe-all.jar in $basedir/build/libs (or $basedir); run './gradlew shadowJar' to build." >&2
	exit 1
fi

if [ "$on_cygwin" = 1 ]; then
	jar=$(cygpath --windows "$jar")
fi

exec "$java" -jar "$jar" "$@"
